# --- Core ---
NODE_ENV=production
PORT=5000

# --- Database (required) ---
# MongoDB Atlas connection string. Whitelist 0.0.0.0/0 in Atlas Network Access for Render.
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/smartopd?retryWrites=true&w=majority

# --- Auth (required) ---
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Frontend origin(s) for CORS (comma-separated) ---
CLIENT_URL=https://srm-mediassist.vercel.app

# --- OpenAI (required for the assistant; server runs in degraded mode if absent) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL_MEDICAL=gpt-5
OPENAI_MODEL_ASSISTANT=gpt-5
OPENAI_MODEL_INTENT=gpt-4o
OPENAI_MODEL_STT=gpt-4o-transcribe
OPENAI_MODEL_TTS=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_MEDICAL_REASONING_EFFORT=low

# --- Email (optional; OTP delivery falls back to displayOtp if missing) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=

# --- SMS (optional; Fast2SMS) ---
FAST2SMS_API_KEY=

# --- Vitals kiosk (optional) ---
KIOSK_DEVICE_KEY=

# --- Demo seed data on first boot ---
DEMO_MODE=true
